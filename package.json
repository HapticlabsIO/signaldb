{
  "name": "signaldb-workspace",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "preversion": "npm run lint && npm run test -- run && npm run build",
    "prepare": "npm run build",
    "lint": "eslint .",
    "test": "vitest",
    "bench": "vitest bench",
    "typedoc": "typedoc",
    "coverage": "vitest run --coverage",
    "build": "npm run build -w packages/base/core -w packages/history/history",
    "check:reproducible-build": "node scripts/checkReproducibleBuild.mts",
    "type-check": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run build && npm run typedoc && npm run docs:build-vitepress",
    "docs:build-vitepress": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "author": "Max Nowack <max.nowack@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "packages/base/*",
    "packages/history/*"
  ],
  "dependencies": {
    "@rollup/plugin-typescript": "12.3.0",
    "rimraf": "6.1.3",
    "rollup-plugin-typescript-paths": "1.5.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "6.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitest/coverage-istanbul": "4.0.18",
    "@vitest/eslint-plugin": "^1.6.6",
    "eslint": "9.39.3",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "fast-glob": "^3.3.3",
    "happy-dom": "20.8.3",
    "husky": "9.1.7",
    "mermaid": "^11.12.2",
    "ts-node": "10.9.2",
    "typedoc": "^0.28.15",
    "typescript-eslint": "^8.52.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "^1.10.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "4.0.18"
  }
}
